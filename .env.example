# ---------------------------------------------------------------
# Question Paper Studio — environment template
# Copy to .env and fill in your own values. NEVER commit real keys.
# ---------------------------------------------------------------

# Google Gemini (primary AI provider for question generation)
# Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the model (default gemini-2.5-flash). Any key format (AIza... or AQ...) works.
GEMINI_MODEL=gemini-2.5-flash

# Supabase — database, auth and storage
# Create a project at https://supabase.com and copy these from Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key   # server only, keep secret

# Same Supabase values exposed to the browser build (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# Seed script (scripts/seed-test-users.ts) — required only when seeding test users
SEED_SUPER_ADMIN_EMAIL=sha@gmail.com
SEED_SUPER_ADMIN_PASSWORD=choose_a_strong_password
SEED_COLLEGE_ADMIN_EMAIL=demo123@gmail.com
SEED_COLLEGE_ADMIN_PASSWORD=choose_a_strong_password

# End-to-end tests (npm run test:e2e)
# The tests provision this throwaway org admin themselves against a real
# Supabase project, so only pick a password you are happy to reuse in CI.
E2E_EMAIL=e2e.institute.admin@paperhub.test
E2E_PASSWORD=choose_a_strong_password
# Organization the test admin is attached to. Must already exist.
E2E_ORG_ID=00000000-0000-0000-0000-000000000001
# Optional. Defaults to http://localhost:4174.
E2E_BASE_URL=http://localhost:4174
